# Required — all /notify and /connect requests must include X-API-Key: <value>
API_KEY=your-secret-key-here

# Required for AI replies — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional
SERVICE_NAME=WhatsApp Notification Service
PORT=3000
LOG_LEVEL=info

# Required on Railway/cloud hosts where WhatsApp blocks the egress IP
# Use any HTTP/HTTPS/SOCKS5 proxy URL, e.g. from Fixie, Bright Data, etc.
# PROXY_URL=http://user:pass@proxy.example.com:8080
